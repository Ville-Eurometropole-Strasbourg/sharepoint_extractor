SPX_SITE_URL=https://sharepoint.example.org
SPX_ROOT_NAME=
SPX_USERNAME=
SPX_PASSWORD=
# Optional: PEM bundle for an internal CA, as seen from the container
# (e.g. /app/certs/ca_bundle.pem). Empty = certifi's public CA list.
SPX_CA_BUNDLE=
# Optional: output folder, default ./discovery_output
SPX_OUTPUT_DIR=
SPX_INSPECT_PATH=
# Optional: subnet of the extractor's Docker network, default 10.200.0.0/24
SPX_DOCKER_SUBNET=
COMPOSE_PROJECT_NAME=sharepoint_extract
